# SAARTHI Production & Security Environment Configuration
NODE_ENV=development
PORT=3000

# Admin Authentication (Required in production; never commit real values)
ADMIN_USERNAME=s.adhikari
ADMIN_PASSWORD=replace_with_strong_admin_password
SESSION_SECRET=replace_with_64_char_random_hex_secret

# SMTP Notification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=replace_with_app_password
EMAIL_FROM_ADDRESS=your-smtp-user@gmail.com
EMAIL_FROM_NAME=SAARTHI Platform
ADMIN_NOTIFICATION_EMAIL=owner@yourdomain.com

# Android Trusted Web Activity (Google Play App Signing SHA-256 Fingerprint)
ANDROID_PLAY_SIGNING_SHA256=

# GitHub Automated Sync
GITHUB_TOKEN=
GITHUB_BACKUP_REPO_URL=https://github.com/sdxbyte/saarthi
