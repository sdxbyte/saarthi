{
  "name": "saarthi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild src/serverApp.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/vercel-server.cjs",
    "sync:github": "tsx scripts/auto-sync-github.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "VITE_IS_NATIVE_APK=true VITE_API_BASE_URL=https://saarthi.dpdns.org vite build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@sbmdkl/nepali-date-converter": "^2.0.5",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "bikram-sambat": "^1.8.1",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "jsdom": "^31.0.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nepali-date-converter": "^3.4.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "nanoid": ">=3.3.18 <4.0.0",
    "dompurify": ">=3.4.17",
    "uuid": ">=11.1.1",
    "proxy-addr": ">=2.0.8",
    "body-parser": ">=1.20.9 <2.0.0",
    "qs": ">=6.17.1",
    "source-map-js": ">=1.2.2",
    "@grpc/grpc-js": ">=1.13.6"
  },
